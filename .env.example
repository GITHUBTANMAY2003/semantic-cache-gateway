UPSTREAM_BASE_URL=http://localhost:11434/v1
UPSTREAM_API_KEY=
# Where Redis Stack listens (docker compose up -d redis).
REDIS_URL=redis://localhost:6379
# "redis" or "memory"; memory needs no Docker but forgets everything on restart.
CACHE_BACKEND=redis
# Embedding model: 384-d vectors, small enough for CPU.
EMBED_MODEL=BAAI/bge-small-en-v1.5
# Similarity at or above this is a direct semantic hit.
TAU_HIGH=0.98
# Requests with a higher temperature skip the cache: the caller wants variety.
MAX_CACHE_TEMPERATURE=0.3
# How long a stored answer lives (24 h).
CACHE_TTL_SECONDS=86400
# Bearer token for DELETE /admin/cache; empty disables the endpoint.
ADMIN_TOKEN=
